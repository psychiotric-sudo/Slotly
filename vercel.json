{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/((?!manifest.webmanifest|icon-.*|favicon.*|apple-touch-icon.*|og-image.*|robots.txt|sitemap.xml).*)", "destination": "/index.html" }]
}
